# Supabase > Project Settings > API. Use the anon/public key ONLY. Never put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Development only (ignored in production builds): shows the UI with fictional demo data, no login.
VITE_DEMO_MODE=false
